# Fuentes materializadas por la ingesta del servidor
PATH_LEVANTE=/ruta/servidor/data/parquet/levante
PATH_ASIGNACIONES_COM=/ruta/servidor/data/processed/com_contenedor_cluster/asignaciones_com
PATH_CLUSTER_ACTUAL=/ruta/servidor/data/processed/cluster_update_check/contenedor_posicion_cluster_actual

# Modelo y estado inicial para la primera corrida
PATH_MODELO=/ruta/servidor/modelos/modelo_logistico_reducido.rds
PATH_ESTADO_INICIAL=/ruta/servidor/estado_inicial/estado_historico_cluster

# Salida persistente que consume la app
OUT_BASE_APP=/ruta/servidor/data/processed/app

# Versiones operativas
MODELO_ID=logistico_reducido_d2
VERSION_MODELO=v2026_06_09
VERSION_CLUSTER=v2026_05_25

# Reglas temporales
HORA_CORTE_LEVANTES=01:00:00
REZAGO_RECLAMOS_DIAS=2
VENTANA_DIAS=120
MAX_MINUTOS_LOCK=180

# FECHA_OBJETIVO_HASTA puede omitirse para usar la fecha local de la corrida.
# FECHA_COM_CERRADA_HASTA debe enviarla el proceso de ingesta o control de COM.
# FECHA_FUENTE_LEVANTE_HASTA puede usarse para pruebas; en produccion se
# recomienda validar directamente fecha_levante.
